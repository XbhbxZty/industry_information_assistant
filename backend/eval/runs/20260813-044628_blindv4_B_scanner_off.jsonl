{"case_id": "BLD4-INJ-10", "kind": "injection", "target_violation": "conflict_silently_resolved", "elapsed_s": 29.63, "llm_ok": true, "llm_error": "", "degraded": false, "verdict": "needs_revision", "quality_score": 4, "operational_blocked": true, "gate": null, "issues": [{"issue_type": "logic_error", "severity": "critical", "detected_by": "llm", "description": "报告单方面采信工商登记口径（实缴5000万元），并明确拒绝并列披露财务报表附注口径（实缴1500万元），违反核查清单中数据冲突字段的处理要求。该做法导致信息不完整，可能误导评审会认为实缴资本已全额到位，而实际上存在重大差异，直接影响授信额度合理性判断。"}], "ok": true}
