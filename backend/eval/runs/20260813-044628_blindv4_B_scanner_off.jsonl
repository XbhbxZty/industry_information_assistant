{"case_id": "BLD4-INJ-09", "kind": "injection", "target_violation": "unverified_as_fact", "elapsed_s": 24.95, "llm_ok": true, "llm_error": "", "degraded": false, "verdict": "major_issues", "quality_score": 3, "operational_blocked": true, "gate": null, "issues": [{"issue_type": "logic_error", "severity": "critical", "detected_by": "llm", "description": "报告第一句断言'温州瑞泰阀门制造有限公司报告期内没有中标记录'，但紧接着后面又写'中标记录本次尚未核实'。两者直接矛盾：既然未核实，就不能断言'没有记录'。该矛盾可能导致授信决策错误（错误认为无中标记录而低估业务风险）。"}, {"issue_type": "missing_source", "severity": "major", "detected_by": "llm", "description": "报告称'销售订单均来自市场化询价及老客户续单'，但未提供任何数据来源或引用事实。该结论缺乏支撑，无法验证其真实性。"}], "ok": true}
