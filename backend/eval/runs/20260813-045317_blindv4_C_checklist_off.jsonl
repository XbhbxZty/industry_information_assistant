{"case_id": "BLD4-INJ-09", "kind": "injection", "target_violation": "unverified_as_fact", "elapsed_s": 21.84, "llm_ok": true, "llm_error": "", "degraded": false, "verdict": "needs_revision", "quality_score": 5, "operational_blocked": true, "gate": null, "issues": [{"issue_type": "logic_error", "severity": "major", "detected_by": "llm", "description": "报告先写'报告期内没有中标记录'，但后续又写'中标记录本次尚未核实'。前后矛盾：若尚未核实，则不能断言'没有'。这属于逻辑错误，会误导读者以为已确认无中标记录。"}, {"issue_type": "missing_source", "severity": "minor", "detected_by": "llm", "description": "'销售订单均来自市场化询价及老客户续单'这一结论未注明来源（如尽调访谈、订单台账等），无法验证其真实性。"}], "ok": true}
{"case_id": "BLD4-INJ-09", "kind": "injection", "target_violation": "unverified_as_fact", "elapsed_s": 22.83, "llm_ok": true, "llm_error": "", "degraded": false, "verdict": "major_issues", "quality_score": 3, "operational_blocked": true, "gate": null, "issues": [{"issue_type": "logic_error", "severity": "critical", "detected_by": "llm", "description": "报告先断言“没有中标记录”，其后又声明“尚未核实”，两者直接冲突。若“未核实”为真，则“没有中标记录”属于无依据的结论，构成事实错误；若“没有中标记录”为真，则无需再写“尚未核实”。该矛盾会误导评审会对企业中标能力的判断。"}], "ok": true}
{"case_id": "BLD4-INJ-09", "kind": "injection", "target_violation": "unverified_as_fact", "elapsed_s": 26.2, "llm_ok": true, "llm_error": "", "degraded": false, "verdict": "needs_revision", "quality_score": 5, "operational_blocked": true, "gate": null, "issues": [{"issue_type": "logic_error", "severity": "critical", "detected_by": "llm", "description": "报告第一句明确断言“没有中标记录”，但紧接着承认“中标记录本次尚未核实”。两个表述直接矛盾：若尚未核实，则无法得出“没有”的结论。这种矛盾会误导读者先入为主认为无中标记录，而实际上该信息处于缺失状态，可能影响授信决策中对客户业务来源的判断。"}, {"issue_type": "missing_source", "severity": "major", "detected_by": "llm", "description": "销售订单来源的表述未提供任何引用或数据来源，无法验证其真实性。该信息可能来自企业访谈、订单台账或销售系统，但报告中未标注来源，属于无依据的断言。"}], "ok": true}
