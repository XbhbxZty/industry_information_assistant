{"case_id": "BLD4-INJ-07", "kind": "injection", "target_violation": "unverified_as_fact", "elapsed_s": 28.54, "llm_ok": true, "llm_error": "", "degraded": false, "verdict": "needs_revision", "quality_score": 6, "operational_blocked": true, "gate": null, "issues": [{"issue_type": "logic_error", "severity": "major", "detected_by": "llm", "description": "报告从‘未发现负面舆情’推断出‘未受到监管处罚’，这是逻辑跳跃。监管处罚字段在核查清单中状态为‘未核实’，不能因无负面舆情就得出无监管处罚的结论。"}], "ok": true}
{"case_id": "BLD4-INJ-08", "kind": "injection", "target_violation": "unverified_as_fact", "elapsed_s": 18.45, "llm_ok": true, "llm_error": "", "degraded": false, "verdict": "major_issues", "quality_score": 2.0, "operational_blocked": true, "gate": {"critical": 1, "major": 0, "original_verdict": "major_issues", "original_score": 2, "fields": ["external_investment"]}, "issues": [{"issue_type": "unverified_as_fact", "severity": "critical", "detected_by": "scanner", "description": "「对外投资」在核查清单中为未核实状态，报告却以「无」作出实质性结论：「且公司无其他对外投资」。未核实既不等于无记录也不等于有记录，正确写法为「该项未核实（原因：本次未查询）」。"}, {"issue_type": "logic_error", "severity": "critical", "detected_by": "llm", "description": "报告在明确声明“股东结构、实际控制人及对外投资均未核实”的前提下，仍断言“确认周启衡为最终控制人，且公司无其他对外投资”。这种自相矛盾的表述表明报告内部逻辑不自治——未核实的信息不得作为结论依据。"}], "ok": true}
{"case_id": "BLD4-INJ-08", "kind": "injection", "target_violation": "unverified_as_fact", "elapsed_s": 33.73, "llm_ok": true, "llm_error": "", "degraded": false, "verdict": "major_issues", "quality_score": 2.0, "operational_blocked": true, "gate": {"critical": 1, "major": 0, "original_verdict": "major_issues", "original_score": 2, "fields": ["external_investment"]}, "issues": [{"issue_type": "unverified_as_fact", "severity": "critical", "detected_by": "scanner", "description": "「对外投资」在核查清单中为未核实状态，报告却以「无」作出实质性结论：「且公司无其他对外投资」。未核实既不等于无记录也不等于有记录，正确写法为「该项未核实（原因：本次未查询）」。"}, {"issue_type": "logic_error", "severity": "critical", "detected_by": "llm", "description": "报告在明确承认股东结构、实际控制人、对外投资均未核实（核查清单状态为『未核实』）后，仍然作出了『周启衡为最终控制人』的实质性结论。该结论与『未核实』状态直接冲突，逻辑上自相矛盾。对外投资部分的断言虽已被程序标记，但实际控制人断言同样属于将未核实字段当作事实断言，且未在程序检出范围内。"}], "ok": true}
{"case_id": "BLD4-INJ-09", "kind": "injection", "target_violation": "unverified_as_fact", "elapsed_s": 26.7, "llm_ok": true, "llm_error": "", "degraded": false, "verdict": "needs_revision", "quality_score": 6, "operational_blocked": true, "gate": null, "issues": [{"issue_type": "logic_error", "severity": "major", "detected_by": "llm", "description": "报告先断言“没有中标记录”，但后文立即说明“中标记录本次尚未核实，未取得完整佐证”。这两个表述相互矛盾：未核实不等于没有记录。正确的做法是统一表述为“中标记录本次尚未核实”，不得向“无记录”方向倾斜。"}], "ok": true}
{"case_id": "BLD4-INJ-09", "kind": "injection", "target_violation": "unverified_as_fact", "elapsed_s": 38.7, "llm_ok": true, "llm_error": "", "degraded": false, "verdict": "needs_revision", "quality_score": 6, "operational_blocked": true, "gate": null, "issues": [{"issue_type": "logic_error", "severity": "major", "detected_by": "llm", "description": "报告首句明确断言‘没有中标记录’，但第二句又称‘中标记录本次尚未核实’。两项表述相互矛盾：若为‘未核实’，则不能得出‘没有’的结论；若已确认‘没有’，则无需再称‘未核实’。该矛盾可能误导审批人，认为已核实无记录。"}], "ok": true}
{"case_id": "BLD4-INJ-09", "kind": "injection", "target_violation": "unverified_as_fact", "elapsed_s": 30.18, "llm_ok": true, "llm_error": "", "degraded": false, "verdict": "needs_revision", "quality_score": 5, "operational_blocked": true, "gate": null, "issues": [{"issue_type": "logic_error", "severity": "critical", "detected_by": "llm", "description": "报告直接断言'没有中标记录'，但随后又承认'中标记录本次尚未核实'。根据核查清单，中标记录为未核实字段，不得给出任何实质性结论（包括'有记录'或'无记录'）。该断言与未核实状态矛盾，且未核实既不等于有也不等于无。"}], "ok": true}
{"case_id": "BLD4-INJ-10", "kind": "injection", "target_violation": "conflict_silently_resolved", "elapsed_s": 32.83, "llm_ok": true, "llm_error": "", "degraded": false, "verdict": "major_issues", "quality_score": 3, "operational_blocked": true, "gate": null, "issues": [{"issue_type": "logic_error", "severity": "critical", "detected_by": "llm", "description": "实缴资本存在数据冲突（工商登记5000万元，财务报表附注1500万元），但报告单方面采信工商登记口径，并称“不再将附注金额作为并列口径披露”，未并列披露冲突来源，也未对效力判断给出客观依据。这违背了冲突字段必须并列披露的原则，可能掩盖真实资本状况，导致授信决策基于错误数据。"}], "ok": true}
