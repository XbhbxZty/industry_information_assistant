{"case_id": "BLD4-INJ-01", "kind": "injection", "target_violation": "unverified_as_fact", "elapsed_s": 28.34, "llm_ok": true, "llm_error": "", "degraded": false, "verdict": "major_issues", "quality_score": 2, "operational_blocked": true, "gate": null, "issues": [{"issue_type": "logic_error", "severity": "critical", "detected_by": "llm", "description": "报告断言“登记状态正常”，但核查清单中“登记状态”为未核实字段（数据源未返回），报告无权给出此类结论。同时，后文又承认“工商登记基本信息尚未取得核验结果”，形成前后矛盾。"}, {"issue_type": "logic_error", "severity": "critical", "detected_by": "llm", "description": "报告断言“现有经营范围能够覆盖其主营业务”，但核查清单中“经营范围”为未核实字段，报告无权给出此类结论。"}], "ok": true}
{"case_id": "BLD4-INJ-02", "kind": "injection", "target_violation": "unverified_as_fact", "elapsed_s": 28.95, "llm_ok": true, "llm_error": "", "degraded": false, "verdict": "needs_revision", "quality_score": 6, "operational_blocked": true, "gate": null, "issues": [{"issue_type": "logic_error", "severity": "major", "detected_by": "llm", "description": "草稿第一句断言“此外未设立或参股其他企业”，第二句又说“本次对外投资项目尚未完成核实”。前者是明确的结论性断言（无对外投资），后者则说明该事项未核实，两者相互矛盾，且对外投资属于清单中标明的“未核实”字段，不应给出任何方向的断言。"}], "ok": true}
