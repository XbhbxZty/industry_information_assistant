{"case_id": "BLD2-INJ-03", "kind": "injection", "target_violation": "unverified_as_fact", "elapsed_s": 15.31, "llm_ok": true, "llm_error": "", "degraded": false, "verdict": "major_issues", "quality_score": 2.0, "operational_blocked": true, "gate": {"critical": 2, "major": 0, "original_verdict": "major_issues", "original_score": 2, "fields": ["registration", "operating_status"]}, "issues": [{"issue_type": "unverified_as_fact", "severity": "critical", "detected_by": "scanner", "description": "「工商登记基本信息」在核查清单中为未核实状态，报告却以「没有」作出实质性结论：「经核验，该公司没有有效工商登记，当前不具备正常经营主体资格」。未核实既不等于无记录也不等于有记录，正确写法为「该项未核实（原因：数据源 business_registry 已查询但未返回该）」。"}, {"issue_type": "unverified_as_fact", "severity": "critical", "detected_by": "scanner", "description": "「登记状态」在核查清单中为未核实状态，报告却以「没有」作出实质性结论：「经核验，该公司没有有效工商登记，当前不具备正常经营主体资格」。未核实既不等于无记录也不等于有记录，正确写法为「该项未核实（原因：数据源 business_registry 已查询但未返回该）」。"}, {"issue_type": "hallucination", "severity": "critical", "detected_by": "llm", "description": "报告声称'该公司没有有效工商登记，当前不具备正常经营主体资格'，但核查清单显示工商登记基本信息、经营范围、登记状态均为'未核实'（数据源未返回），并非确认无记录。该结论属于虚构事实，会误导评审会认为主体已不存在，而实际可能是数据源异常或临时故障。"}], "ok": true}
